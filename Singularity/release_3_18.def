bootstrap: docker
from: docker.io/bioconductor/ml-verse:RELEASE_3_18-R-4.3.3

# work around https://github.com/rocker-org/rocker-versioned2/issues/836
%environment
  if grep -qs sapphire_rapids /sys/devices/cpu/caps/pmu_name
  then
    export OPENBLAS_CORETYPE=SKYLAKEX
  fi

%post
    echo 'options(reticulate.miniconda.url = "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh")' >> $(R RHOME)/etc/Rprofile.site

    # added on Oct 2026 due to EMudhra CA compromise
    # https://ubuntu.com/blog/emudhra-ca-compromise-fixes-available
    apt-get update && apt-get install --only-upgrade -y ca-certificates
